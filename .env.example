DATABASE_URL="file:./dev.db"
AUTH_SECRET="bitte-durch-einen-langen-zufaelligen-wert-ersetzen"
UPLOAD_DIR="./storage/uploads"
NEXT_PUBLIC_BASE_PATH="/Reisekosten"

# --- Vercel / Beta (in den Vercel-Projekteinstellungen setzen, nicht committen) ---
# Postgres (z. B. Neon): DATABASE_URL = gepoolte URL, DIRECT_URL = direkte URL
# DATABASE_URL="postgresql://...?sslmode=require"
# DIRECT_URL="postgresql://...?sslmode=require"
# Vercel Blob (privater Store) für Belege: wird von Vercel automatisch gesetzt
# BLOB_READ_WRITE_TOKEN=""
# Auf Vercel ohne Unterpfad: NEXT_PUBLIC_BASE_PATH="/"
# Selbstregistrierung ist in Produktion standardmäßig aus:
# ALLOW_SELF_REGISTRATION="true"
