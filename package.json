{
  "name": "reisekosten-mvp",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "dev": "prisma generate && next dev",
    "dev:platform": "prisma generate && next dev -p 3010",
    "build": "prisma generate && next build",
    "start": "prisma generate && next start",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:calculation": "node --experimental-strip-types --test tests/calculation.test.ts",
    "db:studio": "prisma studio",
    "setup": "prisma validate && prisma generate && prisma migrate dev --name init && prisma db seed",
    "vercel-build": "node scripts/prepare-postgres-schema.mjs && prisma generate --schema prisma/schema.postgres.prisma && prisma db push --schema prisma/schema.postgres.prisma --skip-generate && next build",
    "admin:create": "node scripts/create-admin.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "1.0.2",
    "@prisma/client": "6.16.2",
    "@tesseract.js-data/deu": "1.0.0",
    "@vercel/blob": "^2.8.1",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "^15.5.27",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.1.200",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tesseract.js": "7.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "prisma": "6.16.2",
    "tsx": "4.19.2",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
