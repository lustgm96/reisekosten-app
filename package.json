{
  "name": "reisekosten-mvp",
  "version": "1.0.2",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "dev": "prisma generate && next dev",
    "build": "prisma generate && next build",
    "start": "prisma generate && next start",
    "typecheck": "tsc --noEmit",
    "test:calculation": "node --experimental-strip-types --test tests/calculation.test.ts",
    "db:studio": "prisma studio",
    "setup": "prisma validate && prisma generate && prisma migrate dev --name init && prisma db seed"
  },
  "dependencies": {
    "@prisma/client": "6.16.2",
    "bcryptjs": "3.0.2",
    "jose": "6.1.0",
    "next": "15.2.4",
    "pdf-lib": "1.17.1",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "prisma": "6.16.2",
    "tsx": "4.19.2",
    "typescript": "5.9.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
